"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#, python-format
msgid "%(count)d athlete"
msgid_plural "%(count)d athletes"
msgstr[0] "%(count)d Athlet"
msgstr[1] "%(count)d Athleten"

#, python-format
msgid "%(user)s (invited)"
msgstr "%(user)s (eingeladen)"

msgid "Name"
msgstr "Name"

msgid "Members"
msgstr "Mitglieder"

#, python-format
msgid "%(name)s (public template)"
msgstr "%(name)s (öffentliche Vorlage)"

msgid "Program"
msgstr "Programm"

#, python-format
msgid "Whole team (%(athletes)s)"
msgstr "Ganzes Team (%(athletes)s)"

msgid "Groups"
msgstr "Gruppen"

msgid "Single athlete"
msgstr "Einzelne Athleten"

msgid "Assign to"
msgstr "Zuweisen an"

msgid "Start date"
msgstr "Startdatum"

msgid "End date"
msgstr "Enddatum"

msgid "The end date must not be before the start date."
msgstr "Das Enddatum darf nicht vor dem Startdatum liegen."

msgid "There are no active athletes in the selected target."
msgstr "In der gewählten Zielgruppe gibt es keine aktiven Athleten."

#, python-format
msgid ""
"This program is already assigned for an overlapping period to: %(names)s"
msgstr ""
"Dieses Programm ist für einen überlappenden Zeitraum bereits zugewiesen an: "
"%(names)s"

msgid "This assignment was already withdrawn."
msgstr "Diese Zuweisung wurde bereits zurückgezogen."

msgid "This is not an open invitation."
msgstr "Das ist keine offene Einladung."

msgid "Please select a valid role."
msgstr "Bitte wähle eine gültige Rolle aus."

msgid "This user is already a member of the team or invited to it."
msgstr "Dieser Benutzer ist bereits Mitglied des Teams oder dazu eingeladen."

msgid "A team needs at least one coach."
msgstr "Ein Team braucht mindestens einen Trainer."

msgid "The last coach of a team cannot be removed."
msgstr "Der letzte Trainer eines Teams kann nicht entfernt werden."

msgid "All members must belong to the team of the group."
msgstr "Alle Mitglieder müssen zum Team der Gruppe gehören."

msgid "The team already has a group with this name."
msgstr "Das Team hat bereits eine Gruppe mit diesem Namen."

msgid "Assign a program"
msgstr "Programm zuweisen"

msgid ""
"Every athlete gets an own copy of the program for this period. Later changes"
" to the template do not change the copies. Invited members who have not "
"accepted yet receive nothing."
msgstr ""
"Jeder Athlet erhält für diesen Zeitraum eine eigene Kopie des Programms. "
"Spätere Änderungen an der Vorlage ändern die Kopien nicht. Eingeladene "
"Mitglieder, die noch nicht angenommen haben, erhalten nichts."

msgid "Assign"
msgstr "Zuweisen"

msgid ""
"You have no templates yet. Create a routine and mark it as template first."
msgstr ""
"Du hast noch keine Vorlagen. Erstelle zuerst einen Trainingsplan und "
"markiere ihn als Vorlage."

msgid "Your templates"
msgstr "Deine Vorlagen"

msgid "Deleted template"
msgstr "Gelöschte Vorlage"

msgid "Teams"
msgstr "Teams"

msgid "Assigned to"
msgstr "Zugewiesen an"

msgid "Period"
msgstr "Zeitraum"

msgid "Assigned by"
msgstr "Zugewiesen von"

msgid "Trained"
msgstr "Trainiert"

#, python-format
msgid "%(trained)s of %(total)s athlete"
msgid_plural "%(trained)s of %(total)s athletes"
msgstr[0] "%(trained)s von %(total)s Athlet"
msgstr[1] "%(trained)s von %(total)s Athleten"

#, python-format
msgid ""
"This assignment was withdrawn on %(date)s. The athletes keep their routines "
"and logs."
msgstr ""
"Diese Zuweisung wurde am %(date)s zurückgezogen. Die Athleten behalten ihre "
"Trainingspläne und Protokolle."

msgid "Athletes"
msgstr "Athleten"

msgid "Athlete"
msgstr "Athlet"

msgid "Routine"
msgstr "Trainingsplan"

msgid "Training sessions"
msgstr "Trainingseinheiten"

msgid "Last activity"
msgstr "Letzte Aktivität"

msgid "Received"
msgstr "Erhalten"

msgid "Deleted by the athlete"
msgstr "Vom Athleten gelöscht"

msgid "Not started"
msgstr "Nicht begonnen"

msgid "Withdraw this assignment? The athletes keep their routines and logs."
msgstr ""
"Diese Zuweisung zurückziehen? Die Athleten behalten ihre Trainingspläne und "
"Protokolle."

msgid "Withdraw assignment"
msgstr "Zuweisung zurückziehen"

msgid "Invitations"
msgstr "Einladungen"

#, python-format
msgid "You are invited to join <strong>%(team)s</strong>."
msgstr "Du bist eingeladen, dem Team <strong>%(team)s</strong> beizutreten."

msgid "Accept"
msgstr "Annehmen"

msgid "Decline"
msgstr "Ablehnen"

msgid "Your programs"
msgstr "Deine Programme"

msgid "Assigned to you personally"
msgstr "Dir persönlich zugewiesen"

msgid "You deleted this routine"
msgstr "Du hast diesen Trainingsplan gelöscht"

msgid "Withdrawn by the coach"
msgstr "Vom Trainer zurückgezogen"

msgid "No programs were assigned to you yet."
msgstr "Dir wurden noch keine Programme zugewiesen."

msgid "Your teams"
msgstr "Deine Teams"

msgid "Coach"
msgstr "Trainer"

msgid "You are not a member of a team yet."
msgstr "Du bist noch in keinem Team Mitglied."

msgid "New team"
msgstr "Neues Team"

msgid "Create a team to invite athletes and assign programs to them."
msgstr ""
"Erstelle ein Team, um Athleten einzuladen und ihnen Programme zuzuweisen."

msgid "Create team"
msgstr "Team erstellen"

msgid "Programs"
msgstr "Programme"

msgid "Whole team"
msgstr "Ganzes Team"

#, python-format
msgid "%(count)s athlete"
msgid_plural "%(count)s athletes"
msgstr[0] "%(count)s Athlet"
msgstr[1] "%(count)s Athleten"

msgid "Withdrawn"
msgstr "Zurückgezogen"

msgid "No programs were assigned in this team yet."
msgstr "In diesem Team wurden noch keine Programme zugewiesen."

msgid "User"
msgstr "Benutzer"

msgid "Role"
msgstr "Rolle"

msgid "Actions"
msgstr "Aktionen"

msgid "Invited"
msgstr "Eingeladen"

msgid "Make athlete"
msgstr "Zum Athleten machen"

msgid "Make coach"
msgstr "Zum Trainer machen"

msgid "Withdraw invitation"
msgstr "Einladung zurückziehen"

msgid "Remove"
msgstr "Entfernen"

msgid "Invite a member"
msgstr "Mitglied einladen"

msgid "Username or e-mail address"
msgstr "Benutzername oder E-Mail-Adresse"

msgid "Invite"
msgstr "Einladen"

msgid ""
"The user needs an account and has to accept the invitation on the teams "
"page."
msgstr ""
"Der Benutzer braucht ein Konto und muss die Einladung auf der Teams-Seite "
"annehmen."

msgid ""
"Groups are parts of the team, e.g. the goalkeepers. A program can be "
"assigned to a group only."
msgstr ""
"Gruppen sind Teile des Teams, z. B. die Torhüter. Ein Programm kann auch nur"
" einer Gruppe zugewiesen werden."

msgid "No members"
msgstr "Keine Mitglieder"

msgid "Edit"
msgstr "Bearbeiten"

msgid "Save"
msgstr "Speichern"

msgid "Delete group"
msgstr "Gruppe löschen"

msgid "This team has no groups yet."
msgstr "Dieses Team hat noch keine Gruppen."

msgid "New group"
msgstr "Neue Gruppe"

msgid "Create group"
msgstr "Gruppe erstellen"

msgid "Team settings"
msgstr "Team-Einstellungen"

msgid "Rename"
msgstr "Umbenennen"

msgid "Delete this team? The athletes keep their routines and logs."
msgstr ""
"Dieses Team löschen? Die Athleten behalten ihre Trainingspläne und "
"Protokolle."

msgid "Delete team"
msgstr "Team löschen"

#, python-format
msgid "You are now a member of %(team)s."
msgstr "Du bist jetzt Mitglied von %(team)s."

#, python-format
msgid "You declined the invitation to %(team)s."
msgstr "Du hast die Einladung zu %(team)s abgelehnt."

#, python-format
msgid "Please enter a name with at most %(max)d characters."
msgstr "Bitte gib einen Namen mit höchstens %(max)d Zeichen ein."

msgid "The team was created. Invite your athletes now."
msgstr "Das Team wurde erstellt. Lade jetzt deine Athleten ein."

msgid "The team was renamed."
msgstr "Das Team wurde umbenannt."

msgid "The team was deleted. The athletes keep their routines and logs."
msgstr ""
"Das Team wurde gelöscht. Die Athleten behalten ihre Trainingspläne und "
"Protokolle."

msgid "No user with this username or e-mail address was found."
msgstr ""
"Es wurde kein Benutzer mit diesem Benutzernamen oder dieser E-Mail-Adresse "
"gefunden."

#, python-format
msgid "%(user)s was invited and has to accept the invitation."
msgstr "%(user)s wurde eingeladen und muss die Einladung annehmen."

msgid "The role was changed."
msgstr "Die Rolle wurde geändert."

#, python-format
msgid "%(user)s was removed from the team."
msgstr "%(user)s wurde aus dem Team entfernt."

msgid "The group was created."
msgstr "Die Gruppe wurde erstellt."

msgid "The group was saved."
msgstr "Die Gruppe wurde gespeichert."

msgid "The group was deleted."
msgstr "Die Gruppe wurde gelöscht."

msgid "You are not allowed to make this assignment."
msgstr "Du darfst diese Zuweisung nicht vornehmen."

#, python-format
msgid "The program was assigned, %(count)d athlete received a copy."
msgid_plural "The program was assigned, %(count)d athletes received a copy."
msgstr[0] ""
"Das Programm wurde zugewiesen, %(count)d Athlet hat eine Kopie erhalten."
msgstr[1] ""
"Das Programm wurde zugewiesen, %(count)d Athleten haben eine Kopie erhalten."

msgid ""
"The assignment was withdrawn. The athletes keep their routines and logs."
msgstr ""
"Die Zuweisung wurde zurückgezogen. Die Athleten behalten ihre Trainingspläne"
" und Protokolle."
