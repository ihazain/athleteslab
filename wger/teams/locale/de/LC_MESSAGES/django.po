msgstr[1] "%(count)s weitere Routinen"

msgid "No training is planned for the team in these weeks."
msgstr "In diesen Wochen ist für das Team kein Training geplant."

msgid "No programs were assigned in this team yet."
msgstr "In diesem Team wurden noch keine Programme zugewiesen."

msgid "User"
msgstr "Benutzer"

msgid "Role"
msgstr "Rolle"

msgid "Actions"
msgstr "Aktionen"

msgid "Invited"
msgstr "Eingeladen"

msgid "Make athlete"
msgstr "Zum Athleten machen"

msgid "Make coach"
msgstr "Zum Trainer machen"

