# Athlete Lab Pro: configuration of the production stack.
#
# Do not edit this file. ./init-env.sh copies it to .env and fills in the
# secrets. .env is not in git and must never be committed.
# All options: settings/main.py

#
# Site
#
# Domain without scheme. Its DNS record must point to this server, Caddy then
# gets the certificate on its own. "localhost" gives a self-signed test setup.
SITE_DOMAIN=__SITE_DOMAIN__
SITE_URL=https://__SITE_DOMAIN__
CSRF_TRUSTED_ORIGINS=https://__SITE_DOMAIN__
TIME_ZONE=Europe/Berlin

# Ports Caddy listens on. Let's Encrypt needs 80 and 443 from outside.
HTTP_PORT=80
HTTPS_PORT=443

#
# Secrets, generated by init-env.sh
#
SECRET_KEY=__SECRET_KEY__
JWT_PRIVATE_KEY=__JWT_PRIVATE_KEY__
JWT_PUBLIC_KEY=__JWT_PUBLIC_KEY__

#
# Database
#
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_DATABASE=athleteslab
DJANGO_DB_USER=athleteslab
DJANGO_DB_PASSWORD=__DB_PASSWORD__
DJANGO_DB_HOST=db
DJANGO_DB_PORT=5432

#
# Application
#
DJANGO_DEBUG=False
WGER_USE_GUNICORN=True
GUNICORN_CMD_ARGS=--workers 3 --timeout 60
# Athletes register themselves, the coach then invites them by username or
# e-mail. Set to False once everybody has an account.
ALLOW_REGISTRATION=True
ALLOW_GUEST_USERS=False
WGER_SHOW_APP_STORE_LINKS=False
LOG_LEVEL_PYTHON=INFO

#
# Behind Caddy
#
X_FORWARDED_PROTO_HEADER_SET=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
NUMBER_OF_PROXIES=1
AXES_IPWARE_PROXY_COUNT=1
AXES_IPWARE_META_PRECEDENCE_ORDER=HTTP_X_FORWARDED_FOR,REMOTE_ADDR

#
# Cache and background tasks
#
DJANGO_CACHE_BACKEND=django_redis.cache.RedisCache
DJANGO_CACHE_LOCATION=redis://cache:6379/1
DJANGO_CACHE_CLIENT_CLASS=django_redis.client.DefaultClient
DJANGO_CACHE_TIMEOUT=1296000
USE_CELERY=True
CELERY_BROKER=redis://cache:6379/2
CELERY_BACKEND=redis://cache:6379/2

#
# E-mail (password reset, confirmation). Without it users cannot reset their
# password on their own.
#
ENABLE_EMAIL=False
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
FROM_EMAIL=Athlete Lab Pro <noreply@__SITE_DOMAIN__>

#
# Backups (backup.sh)
#
BACKUP_KEEP_DAYS=14
# Encrypt the backups for this GnuPG key (must be in the keyring of the user
# who runs backup.sh). Empty: not encrypted.
BACKUP_GPG_RECIPIENT=
# Copy every backup there with rsync, e.g. user@backuphost:/srv/backups/alp
BACKUP_REMOTE=
